{
  "info": {
    "name": "Dispatch Webhook Engine",
    "description": "API collection for the Dispatch Webhook Engine serverless system.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://REPLACE-WITH-DEPLOYED-API-URL",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "POST /events - Valid Request",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"eventType\": \"order.shipped\",\n  \"payload\": {\n    \"orderId\": \"12345\",\n    \"trackingNumber\": \"ABC123\"\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/events",
          "host": ["{{baseUrl}}"],
          "path": ["events"]
        }
      }
    },
    {
      "name": "POST /events - Valid Request with Idempotency-Key",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "order-12345-shipped"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"eventType\": \"order.shipped\",\n  \"payload\": {\n    \"orderId\": \"12345\",\n    \"trackingNumber\": \"ABC123\"\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/events",
          "host": ["{{baseUrl}}"],
          "path": ["events"]
        },
        "description": "Send this request twice. Both responses return 202 with the same eventId, and only one event is created."
      }
    },
    {
      "name": "POST /events - Invalid Idempotency-Key",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "bad key!"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"eventType\": \"order.shipped\",\n  \"payload\": {\n    \"orderId\": \"12345\"\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/events",
          "host": ["{{baseUrl}}"],
          "path": ["events"]
        },
        "description": "Keys may only contain A-Z a-z 0-9 . _ : - and be 1 to 128 characters. Expect 400."
      }
    },
    {
      "name": "POST /events - Invalid Request (missing eventType)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"payload\": {\n    \"orderId\": \"12345\"\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/events",
          "host": ["{{baseUrl}}"],
          "path": ["events"]
        }
      }
    },
    {
      "name": "POST /subscriptions - Valid",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"eventType\": \"order.shipped\",\n  \"url\": \"https://webhook.site/YOUR-ID\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/subscriptions",
          "host": ["{{baseUrl}}"],
          "path": ["subscriptions"]
        }
      }
    },
    {
      "name": "POST /subscriptions - Invalid (http URL)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"eventType\": \"order.shipped\",\n  \"url\": \"http://example.com/hook\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/subscriptions",
          "host": ["{{baseUrl}}"],
          "path": ["subscriptions"]
        }
      }
    },
    {
      "name": "GET /subscriptions",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/subscriptions",
          "host": ["{{baseUrl}}"],
          "path": ["subscriptions"]
        }
      }
    },
    {
      "name": "DELETE /subscriptions/{eventType}",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/subscriptions/order.shipped",
          "host": ["{{baseUrl}}"],
          "path": ["subscriptions", "order.shipped"]
        }
      }
    }
  ]
}
